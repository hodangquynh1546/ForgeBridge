# ForgeBridge configuration
PORT=8090
# Shared secret SmartSpec's backend sends in X-Bridge-Key (and Bridge uses to encrypt stored WorkHub tokens). Use a long random value.
BRIDGE_SECRET=change-me-to-a-long-random-string
WORKHUB_API_URL=http://localhost:8080
# Browser-facing WorkHub URL (what the "Open WorkHub" button opens)
WORKHUB_PUBLIC_URL=http://localhost:5173
# Where Bridge reports WorkHub changes back to SmartSpec, and the key it sends there
SMARTSPEC_API_URL=http://localhost:8000
# Must equal INTEGRATION_WEBHOOK_SECRET in WorkHub (HMAC of the webhook body)
WORKHUB_WEBHOOK_SECRET=change-me-webhook-secret
DB_PATH=./data/bridge.db
# Full pull of every linked project (repairs missed webhooks), in seconds
RECONCILE_SECONDS=300

# GitHub: webhook (event Pull requests) tới POST /webhooks/github. Branch/tiêu đề PR chứa mã task (SHOP-12) thì task tự đổi trạng thái.
# GITHUB_WEBHOOK_SECRET=
# Trạng thái khi PR được merge: TESTING (mặc định, QA xác nhận rồi mới DONE) hoặc DONE
# GIT_MERGED_STATUS=TESTING
