{
  "name": "forge-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ForgeBridge: keeps SmartSpec (specs) and WorkHub (tasks) in sync and serves the IDE.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "mcp": "tsx src/mcp.ts",
    "mcp:smartspec": "tsx src/smartspec-mcp-stdio.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}